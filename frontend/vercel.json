{
  "version": 2,
  "outputDirectory": "build",
  "routes": [
    { "src": "/static/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/(projects|photos|brand|videos)/(.*)", "headers": { "Cache-Control": "public, max-age=604800" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
